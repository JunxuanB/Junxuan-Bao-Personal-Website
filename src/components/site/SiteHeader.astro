---
interface Props {
  lang: 'en' | 'zh';
  mode: 'personal' | 'business';
  personalHref: string;
  businessHref: string;
  langHref: string;
}
const { lang, mode, personalHref, businessHref, langHref } = Astro.props;
const zh = lang === 'zh';
---
<header class="site-header">
  <a class="brand" href={mode === 'personal' ? personalHref : businessHref}>
    <span class="brand-mark" aria-hidden="true"></span>
    <span class="brand-text">{mode === 'personal' ? (zh ? '鲍俊轩' : 'Junxuan Bao') : 'JB Solutions'}</span>
  </a>
  <nav class="mode-switch" aria-label={zh ? '切换个人与公司' : 'Personal or business'}>
    <a href={personalHref} aria-current={mode === 'personal' ? 'page' : undefined}>Personal</a>
    <a href={businessHref} aria-current={mode === 'business' ? 'page' : undefined}>Business</a>
  </nav>
  <div class="header-tools">
    <a class="icon-btn" href={langHref} hreflang={zh ? 'en' : 'zh-CN'} lang={zh ? 'en' : 'zh-CN'} aria-label={zh ? 'Switch to English' : '切换到中文'}>{zh ? 'EN' : '中文'}</a>
    <button class="icon-btn" type="button" data-theme-toggle aria-label={zh ? '切换深浅色' : 'Switch light or dark mode'}>
      <svg class="theme-icon-light" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      <svg class="theme-icon-dark" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
    </button>
  </div>
</header>
