  <main class="legal" style="text-align: center; padding-top: 120px">
    <p class="kicker">404</p>
    <h1 class="b-h2" style="margin-top: 12px">Page not found<span class="period">.</span></h1>
    <p class="muted" style="margin-top: 12px" lang="zh-CN">页面不存在。</p>
    <div class="b-ctas">
      <a class="btn btn-primary" href="/">Personal</a>
      <a class="btn btn-soft" href="/business/">Business</a>
      <a class="btn btn-soft" href="/full-stack-tutorial/000-index/">Tutorials</a>
    </div>
  </main>
</SiteLayout>
